{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketTefia",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::tefiaenteatro.com"]
    },
    {
      "Sid": "GestionarObjetosTefia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::tefiaenteatro.com/*"]
    },
    {
      "Sid": "InvalidarCacheCloudFrontTefia",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": ["arn:aws:cloudfront::282662225889:distribution/E29CMKJWGWAZ58"]
    }
  ]
}
